{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "root": false,
  "files": {
    "includes": [
      "src/**",
      "examples/demo/src/**/*.css",
      "examples/demo/src/**/*.ts",
      "examples/demo/src/**/*.tsx",
      "tests/**",
      "tools/**",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  }
}
